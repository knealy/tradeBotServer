# ============================================================================
# .env.example - Template for tradeBotServer configuration
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# TOPSTEPX API CREDENTIALS (Required)
# ============================================================================
PROJECT_X_API_KEY="YOUR_API_KEY_HERE"
PROJECT_X_USERNAME="your_username"
PROJECT_X_ACCOUNT_ID="12345678"

# Legacy aliases (kept for backward compatibility)
TOPSTEPX_API_KEY="YOUR_API_KEY_HERE"
TOPSTEPX_USERNAME="your_username"
TOPSTEPX_ACCOUNT_ID="12345678"

# JWT Token (auto-refreshed by system)
JWT_TOKEN="will_be_generated_automatically"


# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL="postgresql://user:password@host:port/database"
PUBLIC_DATABASE_URL="postgresql://user:password@host:port/database"

# Database connection details
POSTGRES_HOST="your_host"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_password"
POSTGRES_DB="your_database"


# ============================================================================
# DISCORD NOTIFICATIONS & BOT (Optional)
# ============================================================================
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN"
DISCORD_COMMAND_CHANNEL_ID="YOUR_CHANNEL_ID"
DISCORD_COMMAND_ALLOWED_USER_IDS="USER_ID_1,USER_ID_2"


# ============================================================================
# LOGGING & DEBUGGING
# ============================================================================
LOG_LEVEL="INFO"
ENABLE_FILE_LOGGING="true"
DEBUG_MODE="false"


# ============================================================================
# SYSTEM SETTINGS
# ============================================================================
STRATEGY_TIMEZONE="US/Eastern"
API_TIMEOUT="30"
MAX_RETRIES="3"
RUST_HTTP_TIMEOUT_SECONDS="45"
API_RATE_LIMIT_MAX="60"
API_RATE_LIMIT_PERIOD="60"
TOPSTEPX_USE_RUST="true"


# ============================================================================
# OVERNIGHT RANGE STRATEGY
# ============================================================================

# Timing (override via CLI: --overnight-start, --overnight-end, --market-open, --zone-anchor)
OVERNIGHT_START_TIME="18:00"
OVERNIGHT_END_TIME="18:15"
MARKET_OPEN_TIME="18:15"
ZONE_ANCHOR_TIME="18:15"

# ATR Configuration (used when MOR-style SL/TP is off; see --use-range-pct-sltp in run_overnight.sh)
ATR_PERIOD="14"
ATR_TIMEFRAME="15m"
STOP_ATR_MULTIPLIER="1.25"
TP_ATR_MULTIPLIER="1.5"

# MOR-style SL/TP (or pass via CLI: --use-range-pct-sltp --stop-range-pct=50 --tp-range-pct=100)
USE_RANGE_PCT_SLTP="false"
STOP_RANGE_PCT="50.0"
TP_RANGE_PCT="100.0"

# Position Management
BREAKEVEN_ENABLED="true"
BREAKEVEN_PROFIT_POINTS="15.0"
RANGE_BREAK_OFFSET="0.25"
USE_DYNAMIC_ATR_FOR_ORDERS="true"

# Breakout Monitoring
BREAKOUT_MONITOR_ENABLED="true"
BREAKOUT_PROXIMITY_PERCENT="10.0"
BREAKOUT_MIN_PROXIMITY_POINTS="5.0"
BREAKOUT_MONITOR_INTERVAL_SECONDS="15.0"

# Market Condition Filters
OVERNIGHT_FILTER_RANGE_SIZE="false"
OVERNIGHT_FILTER_GAP="false"
OVERNIGHT_FILTER_VOLATILITY="false"
OVERNIGHT_FILTER_DLL_PROXIMITY="false"

# Filter Thresholds
OVERNIGHT_RANGE_MIN_POINTS="50.0"
OVERNIGHT_RANGE_MAX_POINTS="500.0"
OVERNIGHT_GAP_MAX_POINTS="200.0"
OVERNIGHT_ATR_MIN="20.0"
OVERNIGHT_ATR_MAX="200.0"
OVERNIGHT_DLL_THRESHOLD_PERCENT="0.75"

# Risk Management
OVERNIGHT_RANGE_RESPECT_DLL="true"
OVERNIGHT_RANGE_RESPECT_MLL="true"
OVERNIGHT_RANGE_MAX_DLL_USAGE="0.75"

# Position Sizing (prefer --risk-config CLI arg)
STRATEGY_QUANTITY="1"
OVERNIGHT_RANGE_POSITION_SIZE="1"
OVERNIGHT_RANGE_MAX_POSITIONS="2"
OVERNIGHT_RANGE_MAX_DAILY_TRADES="4"

# Strategy Control
OVERNIGHT_RANGE_ENABLED="true"
OVERNIGHT_RANGE_SYMBOLS="MGC"


# ============================================================================
# RISK LIMITS (Account-Level)
# ============================================================================
INITIAL_BALANCE="150000.00"
DAILY_LOSS_LIMIT="1000.00"
MAXIMUM_LOSS_LIMIT="1000.00"
GLOBAL_MAX_POSITIONS="5"
MAX_CONCURRENT_STRATEGIES="3"


# ============================================================================
# CACHING & PERFORMANCE
# ============================================================================
CACHE_FORMAT="parquet"
CACHE_TTL_DEFAULT="5"
CACHE_TTL_MARKET_HOURS="2"
CACHE_TTL_OFF_HOURS="15"
MEMORY_CACHE_MAX_SIZE="50"
MARKET_DATA_CACHE_SIZE="1000"


# ============================================================================
# ADVANCED FEATURES
# ============================================================================
ENABLE_SIGNALR="true"
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_INTERVAL="60"
PREFETCH_ENABLED="true"
PREFETCH_SYMBOLS="MNQ,ES,NQ,MES,MGC"
PREFETCH_TIMEFRAMES="1m,5m,15m"
WEBSOCKET_POOL_MAX_SIZE="5"
WEBHOOK_TIMEOUT="10"
MAX_WEBHOOK_SIZE="1024"
