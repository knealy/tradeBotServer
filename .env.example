# TopStepX API Credentials (Required)
PROJECT_X_API_KEY=your_api_key_here
PROJECT_X_USERNAME=your_username_here

# Optional: Account ID (auto-selects if not provided)
TOPSTEPX_ACCOUNT_ID=your_account_id

# Optional: Rust Control (default: auto-detect)
# TOPSTEPX_USE_RUST=true   # Enable Rust explicitly
# TOPSTEPX_USE_RUST=false  # Disable Rust (use Python only)

# Database (Railway provides automatically)
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Logging
LOG_LEVEL=INFO

# Discord Notifications (Optional)
# DISCORD_WEBHOOK_URL=your_webhook_url

# Strategy Configuration
OVERNIGHT_RANGE_ENABLED=true
OVERNIGHT_RANGE_SYMBOLS=MNQ
