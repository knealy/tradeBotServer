# Copy to .env and fill in values. Never commit .env.
# Strategy knobs: config/strategies/<name>.toml (see core/strategy_config.py).
# To drop legacy strategy env vars from an old .env:  python scripts/slim_env.py

# --- Required ---
PROJECT_X_API_KEY="YOUR_API_KEY_HERE"
PROJECT_X_USERNAME="your_username"
DATABASE_URL="postgresql://user:password@host:5432/database"

# Default account (optional; can pick at runtime)
# PROJECT_X_ACCOUNT_ID="12345678"

# --- Auth aliases (optional; same as PROJECT_X_* ) ---
# TOPSTEPX_API_KEY=""
# TOPSTEPX_USERNAME=""
# TOPSETPX_API_KEY=""   # legacy typo, still accepted

# --- Deploy / session (optional) ---
# JWT_TOKEN=""          # e.g. Railway pre-injected token

# --- Discord (optional) ---
# DISCORD_WEBHOOK_URL=""
# DISCORD_BOT_TOKEN=""
# DISCORD_COMMAND_CHANNEL_ID=""
# DISCORD_COMMAND_ALLOWED_USER_IDS=""

# --- Logging ---
# LOG_LEVEL="INFO"
# LOG_FILE="trading_bot.log"

# --- Risk (account-wide; strategy risk in TOML) ---
# INITIAL_BALANCE="150000.00"
# DAILY_LOSS_LIMIT="1000.00"
# MAXIMUM_LOSS_LIMIT="1000.00"
# GLOBAL_MAX_POSITIONS="5"
# MAX_CONCURRENT_STRATEGIES="3"
# Same-direction contract cap across correlated micro index symbols (MNQ/MES/MYM/M2K); see StrategyRiskManager.
# CORRELATED_EXPOSURE_GUARD="true"
# CORRELATED_MAX_SAME_DIRECTION_CONTRACTS="2"

# --- HTTP / SignalR ---
# API_TIMEOUT="30"
# API_RATE_LIMIT_MAX="60"
# API_RATE_LIMIT_PERIOD="60"
# ENABLE_SIGNALR="true"
# STRATEGY_TIMEZONE="US/Eastern"
# Bounded queue for heavy User Hub tails (PnL, GUI); drops oldest if saturated
# HUB_DEFERRED_QUEUE_MAX="128"

# --- Rust hotpath (optional) ---
# TOPSTEPX_USE_RUST="false"

# --- Remote emergency commands (async webhook / Railway) ---
# Shared secret for POST /api/remote_command (header X-Remote-Command-Secret). Omit to disable endpoint.
# REMOTE_COMMAND_SECRET="long-random-string"

# --- Dashboard webhook (optional) ---
# WEBHOOK_TIMEOUT="10"
# MAX_WEBHOOK_SIZE="1024"
# DB_TELEMETRY_RETENTION_DAYS="30"

# --- Prefetch (optional) ---
# PREFETCH_ENABLED="true"
# PREFETCH_SYMBOLS="MNQ,ES,NQ,MES"
# PREFETCH_TIMEFRAMES="1m,5m"

# More variables: docs/ENV_VARS.md and docs/reference/ENV_CONFIGURATION.md
