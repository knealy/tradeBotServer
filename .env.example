# ============================================================================
# .env.example  —  template for tradeBotServer
# Copy to .env, fill in real values. NEVER commit .env.
#
# Strategy parameters are NOT defined here. They live in
# config/strategies/<strategy_name>.toml and are loaded by
# core.strategy_config.load_strategy_config().
# ============================================================================


# ============================================================================
# TopStepX API credentials  (REQUIRED)
# ============================================================================
PROJECT_X_API_KEY="YOUR_API_KEY_HERE"
PROJECT_X_USERNAME="your_username"
PROJECT_X_ACCOUNT_ID="12345678"

# Legacy aliases — code accepts these as fallbacks (transposed letters).
# Pick one set and stick with it.
# TOPSTEPX_API_KEY="YOUR_API_KEY_HERE"
# TOPSTEPX_USERNAME="your_username"
# TOPSTEPX_ACCOUNT_ID="12345678"

# JWT — auto-refreshed by core/auth.py. Set only on platforms that pre-load
# tokens (e.g. Railway). Leave blank locally.
JWT_TOKEN=""


# ============================================================================
# Database (PostgreSQL)
# ============================================================================
DATABASE_URL="postgresql://user:password@host:5432/database"
# Optional split fields (used by some platforms):
# POSTGRES_HOST=""
# POSTGRES_PORT="5432"
# POSTGRES_USER=""
# POSTGRES_PASSWORD=""
# POSTGRES_DB=""


# ============================================================================
# Discord notifications  (optional)
# ============================================================================
DISCORD_WEBHOOK_URL=""
DISCORD_BOT_TOKEN=""
DISCORD_COMMAND_CHANNEL_ID=""
DISCORD_COMMAND_ALLOWED_USER_IDS=""


# ============================================================================
# Logging  (file=INFO, console=WARNING by default; LOG_LEVEL overrides file)
# ============================================================================
LOG_LEVEL="INFO"
# LOG_FILE="trading_bot.log"          # default; relative paths resolved to repo root


# ============================================================================
# Infrastructure / system settings
# ============================================================================
STRATEGY_TIMEZONE="US/Eastern"
API_TIMEOUT="30"
MAX_RETRIES="3"
API_RATE_LIMIT_MAX="60"
API_RATE_LIMIT_PERIOD="60"
WEBSOCKET_POOL_MAX_SIZE="5"
ENABLE_SIGNALR="true"
HEALTH_CHECK_ENABLED="true"
HEALTH_CHECK_INTERVAL="60"

# Rust hotpath toggle (only get_positions / get_open_orders / get_market_quote
# are wired today — see docs/DECISIONS.md ADR-003)
TOPSTEPX_USE_RUST="false"
RUST_HTTP_TIMEOUT_SECONDS="45"


# ============================================================================
# Account-wide risk limits (cross-strategy; per-strategy risk lives in TOML)
# ============================================================================
INITIAL_BALANCE="150000.00"
DAILY_LOSS_LIMIT="1000.00"
MAXIMUM_LOSS_LIMIT="1000.00"
GLOBAL_MAX_POSITIONS="5"
MAX_CONCURRENT_STRATEGIES="3"


# ============================================================================
# Caching / market data
# ============================================================================
CACHE_FORMAT="parquet"
CACHE_TTL_DEFAULT="5"
CACHE_TTL_MARKET_HOURS="2"
CACHE_TTL_OFF_HOURS="15"
MEMORY_CACHE_MAX_SIZE="50"
MARKET_DATA_CACHE_SIZE="1000"
PREFETCH_ENABLED="true"
PREFETCH_SYMBOLS="MNQ,ES,NQ,MES,MGC"
PREFETCH_TIMEFRAMES="1m,5m,15m"


# ============================================================================
# Webhook / dashboard server  (optional; only when running async_webhook_server)
# ============================================================================
WEBHOOK_TIMEOUT="10"
MAX_WEBHOOK_SIZE="1024"
