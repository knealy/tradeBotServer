# Copy to .env and fill in values. Never commit .env.
# Strategy knobs: config/strategies/<name>.toml (see core/strategy_config.py).
# To drop legacy strategy env vars from an old .env:  python scripts/slim_env.py

# --- Required ---
PROJECT_X_API_KEY="YOUR_API_KEY_HERE"
PROJECT_X_USERNAME="your_username"
DATABASE_URL="postgresql://user:password@host:5432/database"

# Default account (optional; can pick at runtime)
# PROJECT_X_ACCOUNT_ID="12345678"

# --- Auth aliases (optional; same as PROJECT_X_* ) ---
# TOPSTEPX_API_KEY=""
# TOPSTEPX_USERNAME=""
# TOPSETPX_API_KEY=""   # legacy typo, still accepted

# --- Deploy / session (optional) ---
# JWT_TOKEN=""          # e.g. Railway pre-injected token

# --- Discord (optional) ---
# DISCORD_WEBHOOK_URL=""
# Periodic plaintext status embed to the same webhook (seconds; 0 = off). Requires DISCORD_WEBHOOK_URL.
# DISCORD_STATUS_INTERVAL_SECONDS="0"
# DISCORD_BOT_TOKEN=""
# DISCORD_COMMAND_CHANNEL_ID=""
# DISCORD_COMMAND_ALLOWED_USER_IDS=""

# --- Logging ---
# LOG_LEVEL="INFO"
# LOG_FILE="trading_bot.log"

# --- Risk (account-wide; strategy risk in TOML) ---
# INITIAL_BALANCE="150000.00"
# DAILY_LOSS_LIMIT="1000.00"
# MAXIMUM_LOSS_LIMIT="1000.00"
# GLOBAL_MAX_POSITIONS="5"
# MAX_CONCURRENT_STRATEGIES="3"
# Allow starting testing-only built-ins (e.g. simple_candle) via strategy_executor / StrategyManager.start_strategy.
# ALLOW_TESTING_STRATEGIES="1"
# Same-direction contract cap across correlated micro index symbols (MNQ/MES/MYM/M2K); see StrategyRiskManager.
# CORRELATED_EXPOSURE_GUARD="true"
# CORRELATED_MAX_SAME_DIRECTION_CONTRACTS="2"

# --- HTTP / SignalR ---
# API_TIMEOUT="30"
# API_RATE_LIMIT_MAX="60"
# API_RATE_LIMIT_PERIOD="60"
# ENABLE_SIGNALR="true"
# STRATEGY_TIMEZONE="US/Eastern"
# Bounded queue for heavy User Hub tails (PnL, GUI); drops oldest if saturated
# HUB_DEFERRED_QUEUE_MAX="128"

# --- Rust hotpath (recommended ON for live trading) ---
# Native order-placement path (~20–80 ms shaved per order vs Python). Falls back to
# Python on Rust library exceptions; API rejections are NOT retried (same response in
# both paths). Default in this template is "true"; set to "false" to force Python.
# TOPSTEPX_USE_RUST="true"

# --- Performance toggles (all default to fast path) ---
# Live-bar cache warmup (REST → cache pre-fill at executor startup). 0 = off.
# LIVE_BAR_CACHE_WARMUP_BARS="200"
# Live-bar cache hot-path read in get_historical_data (skips REST when fresh). 1 = on.
# LIVE_BAR_CACHE_FIRST="true"
# Idle TLS keep-alive heartbeat (seconds; pings broker auth status to prevent TCP/TLS
# session expiry during dead air). 0 = disable.
# BROKER_KEEPALIVE_HEARTBEAT_SEC="120"
# Strategy loop max ceiling (Option B wake; see CHANGELOG). Smaller = snappier outage
# detection; raise to 30+ if you want less REST traffic during dead-air.
# STRATEGY_LOOP_MAX_INTERVAL_SEC="5"
# Per-iteration symbol parallelism (Option E1: gather analyze() across config.symbols).
# Default true; set "false" for serial behaviour (e.g. debugging deterministic order).
# STRATEGY_SYMBOL_PARALLEL="true"
# Fire-and-forget order POST (Option E2). EXPERIMENTAL — orderId is returned as None
# and downstream handlers (e.g. breakeven monitor) skip registration. Default false.
# STRATEGY_FIRE_AND_FORGET_ORDERS="false"

# --- Remote emergency commands (async webhook / Railway) ---
# Shared secret for POST /api/remote_command (header X-Remote-Command-Secret). Omit to disable endpoint.
# REMOTE_COMMAND_SECRET="long-random-string"

# --- Dashboard webhook (optional) ---
# WEBHOOK_TIMEOUT="10"
# MAX_WEBHOOK_SIZE="1024"
# DB_TELEMETRY_RETENTION_DAYS="30"

# --- Prefetch (optional) ---
# PREFETCH_ENABLED="true"
# PREFETCH_SYMBOLS="MNQ,ES,NQ,MES"
# PREFETCH_TIMEFRAMES="1m,5m"

# --- Offline Databento batch stitch (optional) ---
# Absolute path to a GLBX-* folder under historical_data/price/ when running
# scripts/databento_stitch_canonical.py without --batch-dir (overrides picking newest GLBX-*).
# DATABENTO_BATCH_DIR=""

# Master GUI chart ``GET /api/chart/reload`` default when ``source`` query omitted: auto | api | databento
# CHART_RELOAD_SOURCE="auto"

# --- Backtest throughput (optional) ---
# In-process LRU cache for load_from_csv (path+mtime); set 0 when memory-tight.
# BACKTEST_CSV_CACHE="1"
# BACKTEST_CSV_CACHE_SIZE="4"
# Parallel JSONL matrix: scripts/run_backtest_manifest.py
# BACKTEST_MANIFEST_JOBS="3"

# --- Live-vs-replay drift monitor (core/drift_monitor.py) ---
# Rollout: keep false until you want JSONL capture + offline compare load.
# When true, strategy_executor subscribes to ORDER_FILLED and writes an
# append-only JSONL of every fill to DRIFT_MONITOR_LOG_DIR.
# Compare offline:
#   python -m core.drift_monitor compare --live <jsonl> --replay <backtest.json>
# DRIFT_MONITOR="false"
# DRIFT_MONITOR_LOG_DIR="logs/drift"

# --- Income brain (core/income_brain.py) ---
# Rollout: keep false until sizing rules are validated on paper/small risk.
# When true, TopStepXTradingBot wires broker session PnL + equity into entry sizing
# (see income_brain_entry_quantity / BaseStrategy.place_bracket_order).
# Equity-tier sizing + daily target/stop with HWM trail.
# INCOME_BRAIN="false"
# INCOME_BRAIN_DIVISOR="2500"        # dollars of equity per extra contract
# INCOME_BRAIN_CUSHION="2000"        # subtracted from equity before division
# INCOME_BRAIN_MIN_N="1"             # never below this
# INCOME_BRAIN_MAX_N="20"            # hard cap
# INCOME_BRAIN_HWM_BREACH="2000"     # fall back to MIN_N when HWM-equity > this
# INCOME_BRAIN_DAILY_TARGET="0"      # halt new entries above this realized PnL today (0 = off)
# INCOME_BRAIN_DAILY_STOP="0"        # halt new entries below this realized PnL today (0 = off)
# INCOME_BRAIN_STATE_DIR="data"
# INCOME_BRAIN_TZ="America/New_York"

# More variables: docs/ENV_VARS.md and docs/reference/ENV_CONFIGURATION.md
