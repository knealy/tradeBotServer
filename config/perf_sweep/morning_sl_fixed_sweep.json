{
  "comment": "Sweep signal.sl_fixed_pts for morning_range_reversion on MNQ. min_range_width_points=20 is held constant to remove the narrow-range TP-in-loss noise so the geometry change is the only moving variable. Run with: ENABLE_SIGNALR=false .venv/bin/python scripts/strategy_parameter_sweep.py --manifest config/perf_sweep/morning_sl_fixed_sweep.json --run-id morning_sl_fp_<DATE> --waves morning_sl_fixed",
  "defaults": {
    "timeframe": "5m",
    "replay": true,
    "start": "2024-06-18",
    "end": "2026-05-19",
    "csv_template": "{root}/historical_data/price/{SYM}_5m_databento.csv"
  },
  "waves": [
    {
      "id": "morning_sl_fixed",
      "description": "MNQ morning_range_reversion: vary signal.sl_fixed_pts with narrow-range filter on (min_range_width_points=20).",
      "strategy": "morning_range_reversion",
      "symbols": ["MNQ"],
      "runs": [
        {
          "label": "legacy_half_range_sl",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "0",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        },
        {
          "label": "sl_fp_10",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "10",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        },
        {
          "label": "sl_fp_12",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "12",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        },
        {
          "label": "sl_fp_14",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "14",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        },
        {
          "label": "sl_fp_16",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "16",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        },
        {
          "label": "sl_fp_18",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "18",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        },
        {
          "label": "sl_fp_22",
          "env": {
            "MORNING_RANGE_REVERSION_SIGNAL_SL_FIXED_PTS": "22",
            "MORNING_RANGE_REVERSION_SIGNAL_MIN_RANGE_WIDTH_POINTS": "20"
          }
        }
      ]
    }
  ]
}
