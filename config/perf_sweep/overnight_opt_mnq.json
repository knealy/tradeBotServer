{
  "comment": "MNQ-only overnight_range grid after adopting stop_atr_multiplier=1.5 / tp_atr_multiplier=2.5 in TOML. Every run pins ATR via env so sweeps stay comparable.",
  "defaults": {
    "timeframe": "5m",
    "replay": true,
    "start": "2026-04-11",
    "end": "2026-05-01",
    "csv_template": "{root}/historical_data/price/{sym_lower}_5m_databento.csv"
  },
  "waves": [
    {
      "id": "overnight_session_end_mnq",
      "description": "Overnight range cutoff (timing.overnight_end); ATR pinned 1.5 / 2.5",
      "strategy": "overnight_range",
      "symbols": ["MNQ"],
      "runs": [
        {
          "label": "end_0700",
          "env": {
            "OVERNIGHT_RANGE_SIGNAL_STOP_ATR_MULTIPLIER": "1.5",
            "OVERNIGHT_RANGE_SIGNAL_TP_ATR_MULTIPLIER": "2.5",
            "OVERNIGHT_RANGE_TIMING_OVERNIGHT_END": "7:00"
          }
        },
        {
